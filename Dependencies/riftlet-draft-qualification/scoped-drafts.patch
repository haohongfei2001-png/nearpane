index 0000000000000000000000000000000000000000..78892310a929afdd4ec02dcaf36d10261a0304bb
--- /dev/null
+++ b/Tests/RiftletAdaptersTests/DraftQualificationRouteTests.swift
@@ -0,0 +1,48 @@
+import Foundation
+import RiftletCore
+
+@testable import RiftletAdapters
+
+private enum RouteTestError: Error { case mismatch }
+private func requireRoute(_ value: Bool) throws { guard value else { throw RouteTestError.mismatch } }
+private func accepted(_ url: String, _ route: DraftQualificationRoute?) -> Bool {
+    (try? ChromeClickRoute.page(window: "3", tab: "7", url: url, qualification: route)) != nil
+}
+private func verifyQualificationRoutes() throws {
+    for browser in AttachmentBrowser.allCases {
+        for service in QualificationDraftService.allCases {
+            let route = DraftQualificationRoute(browser: browser, service: service)
+            let fresh = "https://" + service.rawValue + service.freshPath
+            let selected = try ChromeClickRoute.page(window: "3", tab: "7", url: fresh, qualification: route)
+            try requireRoute(selected.window == "3" && selected.tab == "7")
+            for wrong in [
+                fresh + "?q=1", fresh + "#page", fresh + "other",
+                fresh.replacingOccurrences(of: "https://", with: "http://"),
+                fresh.replacingOccurrences(of: "https://", with: "https://id@"),
+                "https://" + service.rawValue + ".invalid" + service.freshPath,
+            ] {
+                try requireRoute(!accepted(wrong, route))
+            }
+            let program = try route.program()
+            try requireRoute(program.qualification == route && program.sourceID == route.adapterID)
+            try requireRoute(route.profile.profileID != OrdinaryProductScreenshotScope.admittedSystemProfile.profileID)
+            _ = try ChromeClickDocumentWitness().bindScript(address: fresh, program: program)
+        }
+    }
+    try requireRoute(!accepted("https://claude.ai/new", nil))
+    try requireRoute(AttachmentBrowser(rawValue: "com.apple.Safari") == nil)
+    let regular = try ChatGPTWebPageProgram.load()
+    try requireRoute(regular.qualification == nil && regular.functionSource.contains("const draftQualification = null;"))
+}
+
+#if canImport(XCTest)
+    import XCTest
+    final class DraftQualificationRouteTests: XCTestCase {
+        func testFixedNativeReceiverAndOrdinaryEligibility() throws { try verifyQualificationRoutes() }
+    }
+#elseif canImport(Testing)
+    import Testing
+    @Suite struct DraftQualificationRouteTests {
+        @Test func fixedNativeReceiverAndOrdinaryEligibility() throws { try verifyQualificationRoutes() }
+    }
+#endif
