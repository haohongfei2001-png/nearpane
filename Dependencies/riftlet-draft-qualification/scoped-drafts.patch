@@ -0,0 +1,59 @@
+import Foundation
+import RiftletCore
+
+/// Offline qualification of a synthetic file. These routes have no production receipt admission.
+public enum QualificationDraftService: String, CaseIterable, Sendable {
+    case chatGPT = "chatgpt.com"
+    case claude = "claude.ai"
+    case gemini = "gemini.google.com"
+    case deepSeek = "chat.deepseek.com"
+    public var freshPath: String {
+        switch self {
+        case .chatGPT, .deepSeek: return "/"
+        case .claude: return "/new"
+        case .gemini: return "/app"
+        }
+    }
+}
+
+public struct DraftQualificationRoute: Equatable, Sendable {
+    public let browser: AttachmentBrowser
+    public let service: QualificationDraftService
+    public init(browser: AttachmentBrowser, service: QualificationDraftService) {
+        self.browser = browser
+        self.service = service
+    }
+    public var adapterID: String { "qualification-v1." + browser.rawValue + "." + service.rawValue }
+    public var profile: ObservationProfile {
+        .init(
+            adapterID: adapterID, surface: .webChat, profileID: adapterID + ".unadmitted", completionSignal: .attached,
+            uploadStartProfileID: adapterID + ".unadmitted-start")
+    }
+    public func permits(url: String) -> Bool {
+        guard let parts = URLComponents(string: url), parts.scheme == "https", parts.host == service.rawValue,
+            parts.user == nil, parts.password == nil, parts.port == nil, parts.query == nil, parts.fragment == nil
+        else { return false }
+        let path = parts.percentEncodedPath
+        return (path.isEmpty ? "/" : path) == service.freshPath
+    }
+    /// Both functions are taken from the same audited resource. A generated literal is closed over at
+    /// compile time; a browser event, page global or URL cannot enable these profiles.
+    public func program() throws -> WebPageProgram {
+        let base = try ChatGPTWebPageProgram.load()
+        guard let pin = base.pinSource else { throw WebAdapterError.programUnavailable }
+        let spec = try JSONSerialization.data(
+            withJSONObject: [
+                "browser": browser.rawValue, "host": service.rawValue, "freshPath": service.freshPath,
+                "adapterID": adapterID,
+            ], options: [.sortedKeys])
+        func bind(_ source: String) throws -> String {
+            let mark = "const draftQualification = null; // RIFTLET_DRAFT_QUALIFICATION"
+            guard source.components(separatedBy: mark).count == 2 else { throw WebAdapterError.programUnavailable }
+            return source.replacingOccurrences(
+                of: mark, with: "const draftQualification = " + String(decoding: spec, as: UTF8.self) + ";")
+        }
+        return WebPageProgram(
+            sourceID: adapterID, functionSource: try bind(base.functionSource), maximumChunkBytes: base.maximumChunkBytes,
+            inputDiscoveryTimeout: base.inputDiscoveryTimeout, pinSource: try bind(pin), qualification: self)
+    }
+}
